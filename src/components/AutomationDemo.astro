---
import ArrowRight from 'lucide-astro/ArrowRight';
import Bell from 'lucide-astro/Bell';
import CalendarCheck from 'lucide-astro/CalendarCheck';
import Stethoscope from 'lucide-astro/Stethoscope';
import Users from 'lucide-astro/Users';
import SectionHeading from './SectionHeading.astro';
import { whatsappLink } from '../data/site';

const cta = whatsappLink('Hola Moriah Studio, vi la demo del asistente de WhatsApp y quiero uno para mi negocio.');

// Acciones que el sistema ejecuta solo cuando el cliente confirma la cita.
const backstage = [
	{ icon: CalendarCheck, text: 'La cita se guarda en el calendario de la clínica' },
	{ icon: Bell, text: 'Se programa un recordatorio un día antes' },
	{ icon: Stethoscope, text: 'El doctor recibe un aviso con los datos' },
	{ icon: Users, text: 'El contacto queda registrado como paciente' },
];
---

<section id="demo" class="scroll-mt-20 py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<SectionHeading
			eyebrow="Demo de automatización"
			title="Pruébalo tú mismo"
			description="Así atiende un asistente de WhatsApp a tus clientes mientras tú trabajas. Toca las opciones del chat."
		/>

		<div class="grid items-center gap-12 lg:grid-cols-[1fr_auto]">
			<!-- Lo que pasa detrás -->
			<div class="order-2 lg:order-1" data-reveal>
				<h3 class="font-display text-2xl font-semibold">Mientras el cliente chatea, el sistema trabaja solo</h3>
				<p class="mt-3 text-gray-soft">
					Agenda una cita en el chat y mira cómo se completan estas tareas sin que nadie toque el teléfono.
				</p>

				<ul class="mt-8 space-y-3" data-backstage>
					{backstage.map((item, i) => {
						const Icon = item.icon;
						return (
							<li class="backstage-item" style={`--i: ${i}`}>
								<span class="backstage-icon"><Icon size={18} /></span>
								<span>{item.text}</span>
							</li>
						);
					})}
				</ul>

				<a
					href={cta}
					target="_blank"
					rel="noopener"
					class="bg-brand-gradient group mt-10 inline-flex items-center gap-2 rounded-full px-7 py-3.5 font-semibold text-white shadow-glow-purple transition-shadow hover:shadow-glow-mix"
				>
					Quiero un asistente así
					<ArrowRight size={18} class="transition-transform group-hover:translate-x-1" />
				</a>
			</div>

			<!-- Teléfono con el chat -->
			<div class="order-1 mx-auto w-full max-w-[22rem] lg:order-2" data-reveal>
				<div class="phone">
					<div class="flex items-center gap-3 border-b border-white/5 bg-[#202c33] px-4 py-3">
						<span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#00a884] font-display text-sm font-bold text-white">N</span>
						<div class="min-w-0 flex-1">
							<p class="truncate text-sm font-semibold text-white">Clínica Nácar</p>
							<p class="text-xs text-[#8696a0]" data-chat-status>en línea</p>
						</div>
						<span class="rounded-full bg-white/10 px-2 py-0.5 text-[10px] font-semibold tracking-wide text-[#8696a0] uppercase">Demo</span>
					</div>

					<div class="chat-body" data-chat-log role="log" aria-live="polite" aria-label="Conversación de demostración">
						<noscript>
							<p class="bubble bubble-bot">Activa JavaScript para probar la demo del asistente.</p>
						</noscript>
					</div>

					<div class="flex min-h-[3.75rem] flex-wrap justify-end gap-2 border-t border-white/5 bg-[#111b21] p-3" data-chat-options></div>
				</div>
				<p class="mt-3 text-center text-xs text-gray-soft">Simulación con fines de demostración. No se envían mensajes.</p>
			</div>
		</div>
	</div>
</section>

<script>
	type Option = { label: string; next: () => void };

	const section = document.querySelector<HTMLElement>('#demo');
	const log = section?.querySelector<HTMLElement>('[data-chat-log]');
	const optionsBox = section?.querySelector<HTMLElement>('[data-chat-options]');
	const status = section?.querySelector<HTMLElement>('[data-chat-status]');
	const backstage = section?.querySelector<HTMLElement>('[data-backstage]');

	if (section && log && optionsBox && status && backstage) {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const typingTime = reduce ? 150 : 900;
		const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
		const time = () => new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
		let busy = false;

		const scrollDown = () => log.scrollTo({ top: log.scrollHeight, behavior: reduce ? 'auto' : 'smooth' });

		const addBubble = (text: string, from: 'bot' | 'user') => {
			const bubble = document.createElement('div');
			bubble.className = `bubble bubble-${from}`;
			bubble.textContent = text;
			const meta = document.createElement('span');
			meta.className = 'bubble-time';
			meta.textContent = from === 'user' ? `${time()} ✓✓` : time();
			bubble.append(meta);
			log.append(bubble);
			scrollDown();
		};

		const botSays = async (lines: string[]) => {
			for (const line of lines) {
				status.textContent = 'escribiendo…';
				const typing = document.createElement('div');
				typing.className = 'bubble bubble-bot typing';
				typing.innerHTML = '<span></span><span></span><span></span>';
				log.append(typing);
				scrollDown();
				await sleep(typingTime + Math.min(line.length * 12, 700) * (reduce ? 0 : 1));
				typing.remove();
				addBubble(line, 'bot');
				status.textContent = 'en línea';
				await sleep(reduce ? 50 : 250);
			}
		};

		const showOptions = (options: Option[]) => {
			optionsBox.replaceChildren(
				...options.map((option) => {
					const button = document.createElement('button');
					button.type = 'button';
					button.className = 'chat-option';
					button.textContent = option.label;
					button.addEventListener('click', async () => {
						if (busy) return;
						busy = true;
						optionsBox.replaceChildren();
						addBubble(option.label, 'user');
						await sleep(reduce ? 50 : 400);
						option.next();
						busy = false;
					});
					return button;
				}),
			);
		};

		const step = async (lines: string[], options: Option[]) => {
			await botSays(lines);
			showOptions(options);
		};

		const resetBackstage = () => backstage.classList.remove('is-done');

		const start = () => {
			resetBackstage();
			step(['¡Hola! 👋 Soy el asistente virtual de Clínica Nácar.', '¿En qué te puedo ayudar?'], mainMenu());
		};

		const mainMenu = (): Option[] => [
			{ label: 'Agendar una cita', next: chooseTreatment },
			{ label: 'Ver precios', next: prices },
			{ label: 'Ubicación y horario', next: location },
		];

		const chooseTreatment = () =>
			step(
				['¡Claro! ¿Qué te gustaría agendar?'],
				['Valoración', 'Limpieza dental', 'Ortodoncia'].map((treatment) => ({
					label: treatment,
					next: () => chooseTime(treatment),
				})),
			);

		const chooseTime = (treatment: string) =>
			step(
				[`Perfecto, ${treatment.toLowerCase()}. Estos son los horarios disponibles para mañana:`],
				['10:00 a. m.', '12:30 p. m.', '5:00 p. m.'].map((hour) => ({
					label: hour,
					next: () => confirm(treatment, hour),
				})),
			);

		const confirm = async (treatment: string, hour: string) => {
			await botSays([
				`¡Listo! ✅ Tu cita de ${treatment.toLowerCase()} quedó agendada para mañana a las ${hour}${hour.endsWith('.') ? '' : '.'}`,
				'Te enviaré un recordatorio un día antes. ¡Te esperamos!',
			]);
			backstage.classList.add('is-done');
			showOptions([{ label: 'Empezar de nuevo', next: restart }]);
		};

		const prices = () =>
			step(
				[
					'Estos son algunos de nuestros precios:',
					'🦷 Valoración: sin costo\n✨ Limpieza dental: $600\n😁 Ortodoncia: desde $1,200 al mes',
					'¿Quieres agendar una cita?',
				],
				[
					{ label: 'Sí, agendar', next: chooseTreatment },
					{ label: 'Volver al inicio', next: restart },
				],
			);

		const location = () =>
			step(
				[
					'📍 Estamos en Av. Ejemplo 123, Centro.',
					'🕘 Lunes a viernes de 9:00 a 19:00 y sábados de 9:00 a 14:00.',
				],
				[
					{ label: 'Agendar una cita', next: chooseTreatment },
					{ label: 'Volver al inicio', next: restart },
				],
			);

		const restart = () => {
			log.replaceChildren();
			start();
		};

		// La conversación arranca cuando el chat aparece en pantalla.
		const observer = new IntersectionObserver(
			([entry]) => {
				if (entry.isIntersecting) {
					observer.disconnect();
					start();
				}
			},
			{ threshold: 0.4 },
		);
		observer.observe(log);
	}
</script>

<style>
	.phone {
		overflow: hidden;
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 2rem;
		background: #0b141a;
		box-shadow:
			0 30px 60px -20px rgb(0 0 0 / 0.8),
			var(--shadow-glow-mix);
	}

	.chat-body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		height: 24rem;
		overflow-y: auto;
		padding: 1rem;
		background-color: #0b141a;
		background-image: radial-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px);
		background-size: 18px 18px;
		scrollbar-width: thin;
	}

	/* Las burbujas se crean desde el script, por eso los estilos son globales dentro de .chat-body */
	.chat-body :global(.bubble) {
		max-width: 85%;
		padding: 0.45rem 0.65rem 0.35rem;
		border-radius: 0.75rem;
		font-size: 0.875rem;
		line-height: 1.35;
		color: #e9edef;
		white-space: pre-line;
		animation: bubble-in 0.25s ease-out;
	}

	.chat-body :global(.bubble-bot) {
		align-self: flex-start;
		border-top-left-radius: 0.25rem;
		background: #202c33;
	}

	.chat-body :global(.bubble-user) {
		align-self: flex-end;
		border-top-right-radius: 0.25rem;
		background: #005c4b;
	}

	.chat-body :global(.bubble-time) {
		display: block;
		margin-top: 0.15rem;
		font-size: 0.6875rem;
		text-align: right;
		color: rgb(233 237 239 / 0.55);
	}

	.chat-body :global(.typing) {
		display: flex;
		gap: 0.25rem;
		padding: 0.7rem 0.8rem;
	}

	.chat-body :global(.typing span) {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 9999px;
		background: #8696a0;
		animation: typing 1.2s infinite ease-in-out;
	}

	.chat-body :global(.typing span:nth-child(2)) {
		animation-delay: 0.15s;
	}

	.chat-body :global(.typing span:nth-child(3)) {
		animation-delay: 0.3s;
	}

	[data-chat-options] :global(.chat-option) {
		padding: 0.45rem 0.9rem;
		border: 1px solid rgb(0 168 132 / 0.5);
		border-radius: 9999px;
		font-size: 0.8125rem;
		font-weight: 600;
		color: #00a884;
		cursor: pointer;
		animation: bubble-in 0.25s ease-out;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	[data-chat-options] :global(.chat-option:hover),
	[data-chat-options] :global(.chat-option:focus-visible) {
		background: #00a884;
		color: #0b141a;
	}

	/* === Panel "lo que pasa detrás" === */
	.backstage-item {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		padding: 0.875rem 1rem;
		border: 1px solid rgb(255 255 255 / 0.05);
		border-radius: 1rem;
		background: var(--color-deep);
		color: var(--color-gray-soft);
		opacity: 0.55;
		transition:
			opacity 0.4s ease,
			border-color 0.4s ease,
			color 0.4s ease;
		transition-delay: 0s;
	}

	.backstage-icon {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 9999px;
		background: var(--color-subtle);
		transition:
			background-color 0.4s ease,
			color 0.4s ease;
		transition-delay: inherit;
	}

	.is-done .backstage-item {
		opacity: 1;
		color: var(--color-silver);
		border-color: rgb(0 168 132 / 0.35);
		transition-delay: calc(var(--i) * 0.45s + 0.2s);
	}

	.is-done .backstage-icon {
		background: #00a884;
		color: white;
	}

	@keyframes bubble-in {
		from {
			opacity: 0;
			transform: translateY(6px) scale(0.97);
		}
	}

	@keyframes typing {
		0%,
		60%,
		100% {
			opacity: 0.35;
			transform: none;
		}
		30% {
			opacity: 1;
			transform: translateY(-3px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.chat-body :global(.bubble),
		[data-chat-options] :global(.chat-option),
		.chat-body :global(.typing span) {
			animation: none;
		}
		.backstage-item,
		.backstage-icon {
			transition: none;
		}
	}
</style>
