---
import { Image } from 'astro:assets';
import ExternalLink from 'lucide-astro/ExternalLink';
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/site';
---

<section id="proyectos" class="scroll-mt-20 py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<SectionHeading
			eyebrow="Proyectos"
			title="Trabajo que puedes visitar"
			description="Un proyecto en producción y demos que muestran lo que podemos construir para ti."
		/>

		<div class="grid gap-6 md:grid-cols-3">
			{projects.map((project) => (
				<a
					href={project.url}
					target="_blank"
					rel="noopener"
					data-reveal
					class="group flex flex-col overflow-hidden rounded-3xl border border-white/5 bg-deep transition-colors hover:border-brand-purple-500/40"
				>
					<div class="relative aspect-[4/3] overflow-hidden">
						<Image
							src={project.image}
							alt={`Captura del sitio de ${project.client}`}
							widths={[400, 800]}
							sizes="(min-width: 768px) 33vw, 100vw"
							class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
						/>
						<span class="absolute top-4 left-4 rounded-full bg-void/80 px-3 py-1 text-xs font-semibold text-silver backdrop-blur">
							{project.type}
						</span>
					</div>
					<div class="flex flex-1 flex-col p-6">
						<p class="text-sm text-brand-blue-400">{project.category}</p>
						<h3 class="mt-2 font-display text-lg font-semibold">{project.client}</h3>
						<p class="mt-2 flex-1 text-gray-soft">{project.description}</p>
						<span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-silver group-hover:text-brand-purple-400">
							Ver sitio <ExternalLink size={16} />
						</span>
					</div>
				</a>
			))}
		</div>
	</div>
</section>
