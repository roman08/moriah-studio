---
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mx-auto mb-14 max-w-2xl text-center" data-reveal>
	<p class="mb-3 text-sm font-semibold tracking-widest text-brand-blue-400 uppercase">{eyebrow}</p>
	<h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
	{description && <p class="mt-4 text-lg text-gray-soft">{description}</p>}
</div>
