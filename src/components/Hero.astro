---
import ArrowRight from 'lucide-astro/ArrowRight';
import Check from 'lucide-astro/Check';
import Sparkles from 'lucide-astro/Sparkles';
import { highlights, whatsappUrl } from '../data/site';
---

<section id="inicio" class="relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-28">
	<!-- Brillos de fondo -->
	<div aria-hidden="true" class="pointer-events-none absolute inset-0">
		<div class="absolute -top-40 left-1/2 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-brand-purple-600/20 blur-3xl"></div>
		<div class="absolute top-1/3 -right-40 h-[400px] w-[400px] rounded-full bg-brand-blue-500/10 blur-3xl"></div>
	</div>

	<div class="relative mx-auto grid max-w-6xl items-center gap-16 px-4 sm:px-6 lg:grid-cols-[1.1fr_1fr]">
		<div>
			<p class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-purple-500/30 bg-brand-purple-500/10 px-4 py-1.5 text-sm text-brand-purple-400">
				<Sparkles size={16} /> Diseño web · Automatización · Software a la medida
			</p>

			<h1 class="font-display text-4xl leading-tight font-bold tracking-tight sm:text-5xl lg:text-6xl">
				Tecnología que hace <span class="text-brand-gradient">crecer tu negocio</span>
			</h1>

			<p class="mt-6 max-w-xl text-lg text-gray-soft">
				Creamos sitios web que atraen clientes, automatizamos las tareas que te quitan tiempo y desarrollamos el sistema que tu negocio necesita.
			</p>

			<div class="mt-10 flex flex-col gap-4 sm:flex-row">
				<a
					href={whatsappUrl}
					target="_blank"
					rel="noopener"
					class="bg-brand-gradient group inline-flex items-center justify-center gap-2 rounded-full px-7 py-3.5 font-semibold text-white shadow-glow-purple transition-shadow hover:shadow-glow-mix"
				>
					Cotiza tu proyecto
					<ArrowRight size={18} class="transition-transform group-hover:translate-x-1" />
				</a>
				<a
					href="#proyectos"
					class="inline-flex items-center justify-center rounded-full border border-white/10 px-7 py-3.5 font-semibold text-silver transition-colors hover:border-white/25 hover:bg-white/5"
				>
					Ver proyectos
				</a>
			</div>

			<ul class="mt-12 flex flex-wrap gap-x-6 gap-y-3 border-t border-white/10 pt-8">
				{highlights.map((item) => (
					<li class="flex items-center gap-2 text-sm text-gray-soft">
						<Check size={16} class="text-brand-blue-400" /> {item}
					</li>
				))}
			</ul>
		</div>

		<!-- Orbe pseudo-3D: solo CSS, sin JavaScript -->
		<div aria-hidden="true" class="relative mx-auto aspect-square w-full max-w-sm lg:max-w-md">
			<div class="animate-spin-slow absolute inset-0 rounded-full border border-dashed border-brand-blue-400/20"></div>
			<div class="animate-spin-slow absolute inset-8 rounded-full border border-brand-purple-400/20 [animation-direction:reverse]"></div>
			<div class="animate-float absolute inset-16">
				<div
					class="h-full w-full rounded-full shadow-glow-mix"
					style="background: radial-gradient(circle at 30% 25%, #E0F2FE 0%, #38BDF8 18%, #3B82F6 40%, #7C3AED 72%, #2E1065 100%);"
				></div>
				<div class="absolute inset-0 rounded-full" style="background: radial-gradient(circle at 70% 80%, transparent 40%, rgba(5,6,15,0.55) 100%);"></div>
				<div class="absolute top-[12%] left-[20%] h-[18%] w-[28%] rotate-[-25deg] rounded-full bg-white/50 blur-xl"></div>
			</div>
			<div class="absolute right-[6%] bottom-[14%] h-6 w-6 rounded-full bg-brand-blue-400 shadow-glow-blue"></div>
			<div class="absolute top-[10%] left-[8%] h-3 w-3 rounded-full bg-brand-purple-400 shadow-glow-purple"></div>
		</div>
	</div>
</section>
