---
import { Image } from 'astro:assets';
import MapPin from 'lucide-astro/MapPin';
import { about } from '../data/site';

// La sección solo se muestra cuando hay una bio real en site.ts.
const show = about.bio.length > 0;
---

{show && (
	<section id="nosotros" class="scroll-mt-20 py-24">
		<div class="mx-auto grid max-w-5xl items-center gap-12 px-4 sm:px-6 md:grid-cols-[auto_1fr]">
			<div data-reveal class="relative mx-auto w-56 md:w-64">
				<div aria-hidden="true" class="absolute -inset-3 rounded-[2rem] bg-brand-gradient opacity-40 blur-2xl"></div>
				{about.photo ? (
					<Image
						src={about.photo}
						alt={`Foto de ${about.name}`}
						widths={[256, 512]}
						sizes="256px"
						class="relative aspect-square w-full rounded-[2rem] border border-white/10 object-cover object-[50%_22%]"
					/>
				) : (
					<div class="bg-brand-gradient relative flex aspect-square w-full items-center justify-center rounded-[2rem] font-display text-6xl font-bold text-white">
						{about.name.split(' ').map((word) => word[0]).join('')}
					</div>
				)}
			</div>

			<div data-reveal>
				<p class="mb-3 text-sm font-semibold tracking-widest text-brand-blue-400 uppercase">Quién está detrás</p>
				<h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{about.name}</h2>
				<p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-gray-soft">
					<span class="whitespace-nowrap">{about.role}</span>
					<span class="inline-flex items-center gap-1.5 whitespace-nowrap"><MapPin size={16} /> {about.location}</span>
				</p>
				<div class="mt-6 space-y-4 text-lg text-gray-soft">
					{about.bio.map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</div>
		</div>
	</section>
)}
