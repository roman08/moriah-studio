---
import ChevronDown from 'lucide-astro/ChevronDown';
import SectionHeading from './SectionHeading.astro';
import { faqs, pricesNote, startingPrices } from '../data/site';
---

<section id="faq" class="scroll-mt-20 py-24">
	<div class="mx-auto max-w-3xl px-4 sm:px-6">
		<SectionHeading eyebrow="Preguntas frecuentes" title="Resolvemos tus dudas" />

		<div class="space-y-4" data-reveal>
			{faqs.map((faq) => (
				<details class="group rounded-2xl border border-white/5 bg-deep open:border-brand-purple-500/30">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 font-semibold [&::-webkit-details-marker]:hidden">
						{faq.question}
						<ChevronDown size={20} class="shrink-0 text-gray-soft transition-transform group-open:rotate-180" />
					</summary>
					<p class="px-6 pb-6 text-gray-soft">{faq.answer}</p>
					{faq.showPrices && startingPrices.length > 0 && (
						<div class="mx-6 mb-6">
							<ul class="divide-y divide-white/5 rounded-xl border border-white/5 bg-elevated">
								{startingPrices.map((price) => (
									<li class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
										<span>
											<span class="block text-silver">{price.service}</span>
											<span class="block text-sm text-gray-soft">{price.detail}</span>
										</span>
										<span class="shrink-0 font-semibold sm:text-right">{price.price}</span>
									</li>
								))}
							</ul>
							<p class="mt-3 text-sm text-gray-soft">{pricesNote}</p>
						</div>
					)}
				</details>
			))}
		</div>
	</div>
</section>
