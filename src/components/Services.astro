---
import Blocks from 'lucide-astro/Blocks';
import MonitorSmartphone from 'lucide-astro/MonitorSmartphone';
import Workflow from 'lucide-astro/Workflow';
import SectionHeading from './SectionHeading.astro';
import { services } from '../data/site';

const icons = { web: MonitorSmartphone, automation: Workflow, custom: Blocks };
---

<section id="servicios" class="scroll-mt-20 py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<SectionHeading
			eyebrow="Servicios"
			title="Soluciones digitales para tu negocio"
			description="Desde tu primera página web hasta el sistema que organiza tu operación."
		/>

		<div class="grid gap-6 md:grid-cols-3">
			{services.map((service) => {
				const Icon = icons[service.icon];
				return (
					<article
						data-reveal
						class="group rounded-3xl border border-white/5 bg-deep p-7 transition-colors hover:border-brand-purple-500/40 hover:bg-elevated"
					>
						<div class="bg-brand-gradient mb-6 inline-flex rounded-2xl p-3 text-white transition-shadow group-hover:shadow-glow-purple">
							<Icon size={24} />
						</div>
						<h3 class="font-display text-xl font-semibold">{service.title}</h3>
						<p class="mt-3 text-gray-soft">{service.description}</p>
					</article>
				);
			})}
		</div>
	</div>
</section>
