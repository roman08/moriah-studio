---
import MessageCircle from 'lucide-astro/MessageCircle';
import { whatsappUrl } from '../data/site';
---

<a
	href={whatsappUrl}
	target="_blank"
	rel="noopener"
	aria-label="Escríbenos por WhatsApp"
	class="fixed right-5 bottom-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/40 transition-transform hover:scale-110"
>
	<MessageCircle size={28} />
</a>
