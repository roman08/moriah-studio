---
// Tarjeta de proyecto o demo, usada en la página principal y en /demos.
import { Image } from 'astro:assets';
import ArrowRight from 'lucide-astro/ArrowRight';
import ExternalLink from 'lucide-astro/ExternalLink';
import MessageCircle from 'lucide-astro/MessageCircle';
import { projectAnchor, projects } from '../data/site';

interface Props {
	project: (typeof projects)[number];
	compact?: boolean;
}

const { project, compact = false } = Astro.props;
const isWhatsapp = project.url.startsWith('https://wa.me/');
const isExternal = project.url.startsWith('http');
const LinkIcon = isWhatsapp ? MessageCircle : isExternal ? ExternalLink : ArrowRight;
---

<a
	id={projectAnchor(project.client)}
	href={project.url}
	target={isExternal ? '_blank' : undefined}
	rel={isExternal ? 'noopener' : undefined}
	data-reveal
	class="group flex scroll-mt-24 flex-col overflow-hidden rounded-3xl border border-white/5 bg-deep transition-colors hover:border-brand-purple-500/40"
>
	<div class="relative aspect-[4/3] overflow-hidden">
		<Image
			src={project.image}
			alt={`Captura de ${project.client}`}
			widths={[400, 800]}
			sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
			class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
		/>
		<span class="absolute top-4 left-4 rounded-full bg-void/80 px-3 py-1 text-xs font-semibold text-silver backdrop-blur">
			{project.type}
		</span>
	</div>
	<div class:list={['flex flex-1 flex-col', compact ? 'p-5' : 'p-6']}>
		<p class="text-sm text-brand-blue-400">{project.category}</p>
		<h4 class="mt-2 font-display text-lg font-semibold">{project.client}</h4>
		<p class:list={['mt-2 flex-1 text-gray-soft', compact && 'text-sm']}>{project.description}</p>
		<span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-silver group-hover:text-brand-purple-400">
			{project.linkLabel ?? 'Ver sitio'} <LinkIcon size={16} />
		</span>
	</div>
</a>
