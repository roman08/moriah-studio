---
import { Image } from 'astro:assets';
import ArrowRight from 'lucide-astro/ArrowRight';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';
import { demoGroups, projects } from '../data/site';

// En la página principal: trabajo real y proyectos personales. Los demos viven en /demos.
const groups = [
	{ title: 'Para clientes', items: projects.filter((p) => p.type === 'Proyecto real'), grid: 'sm:grid-cols-2 lg:grid-cols-3', compact: false },
	{ title: 'Proyectos personales', items: projects.filter((p) => p.type === 'Proyecto personal'), grid: 'sm:grid-cols-2', compact: true },
].filter((group) => group.items.length > 0);

const demos = projects.filter((p) => p.type === 'Demo');
// Miniaturas para la invitación a /demos (una por grupo, en orden)
const previews = demoGroups.map((g) => demos.find((d) => d.demoGroup === g)).filter((d) => d !== undefined).slice(0, 3);
---

<section id="proyectos" class="scroll-mt-20 py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<SectionHeading
			eyebrow="Proyectos"
			title="Trabajo que puedes ver"
			description="Proyectos para clientes y productos propios. Y si quieres probar antes de cotizar, tenemos demos interactivos."
		/>

		<div class="space-y-14">
			{groups.map((group) => (
				<div>
					<h3 class="mb-6 text-sm font-semibold tracking-widest text-gray-soft uppercase" data-reveal>{group.title}</h3>
					<div class:list={['grid gap-6', group.grid]}>
						{group.items.map((project) => <ProjectCard project={project} compact={group.compact} />)}
					</div>
				</div>
			))}

			{demos.length > 0 && (
				<a
					href="/demos"
					data-reveal
					class="group relative grid items-center gap-8 overflow-hidden rounded-3xl border border-brand-purple-500/30 bg-linear-to-br from-elevated to-deep p-8 transition-colors hover:border-brand-purple-500/60 sm:p-10 lg:grid-cols-[1fr_auto]"
				>
					<div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-brand-purple-600/25 blur-3xl"></div>
					<div class="relative">
						<p class="text-sm font-semibold tracking-widest text-brand-blue-400 uppercase">Demos interactivos</p>
						<h3 class="mt-2 font-display text-2xl font-bold sm:text-3xl">Pruébalos antes de cotizar</h3>
						<p class="mt-3 max-w-xl text-gray-soft">
							Haz un pedido en un menú digital, compra en un catálogo, agenda una cita con un bot o abre una invitación. Todo con datos de ejemplo.
						</p>
						<div class="mt-5 flex flex-wrap gap-2">
							{demoGroups
								.filter((g) => demos.some((d) => d.demoGroup === g))
								.map((g) => <span class="rounded-full border border-white/10 px-3 py-1 text-xs font-semibold text-silver">{g}</span>)}
						</div>
						<span class="bg-brand-gradient mt-7 inline-flex items-center gap-2 rounded-full px-6 py-3 font-semibold text-white shadow-glow-purple transition-shadow group-hover:shadow-glow-mix">
							Ver los {demos.length} demos <ArrowRight size={18} class="transition-transform group-hover:translate-x-1" />
						</span>
					</div>

					<!-- Miniaturas en abanico -->
					<div aria-hidden="true" class="relative mx-auto hidden h-56 w-80 sm:block">
						{previews.map((demo, i) => (
							<div
								class="absolute top-1/2 left-1/2 w-48 overflow-hidden rounded-2xl border border-white/10 shadow-2xl transition-transform duration-500"
								style={`transform: translate(-50%, -50%) translateX(${(i - 1) * 95}px) rotate(${(i - 1) * 8}deg); z-index: ${i === 1 ? 2 : 1}`}
							>
								<Image src={demo.image} alt="" widths={[384]} sizes="12rem" class="aspect-[4/3] w-full object-cover object-top" />
							</div>
						))}
					</div>
				</a>
			)}
		</div>
	</div>
</section>
