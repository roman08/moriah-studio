---
import Menu from 'lucide-astro/Menu';
import { nav, site, whatsappUrl } from '../data/site';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-void/70 backdrop-blur-lg">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
		<a href="#inicio" class="font-display text-lg font-bold tracking-tight">
			<span class="text-brand-gradient">Moriah</span> Studio
		</a>

		<nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
			{nav.map((item) => (
				<a href={item.href} class="text-sm text-gray-soft transition-colors hover:text-silver">{item.label}</a>
			))}
		</nav>

		<div class="flex items-center gap-2">
			<a
				href={whatsappUrl}
				target="_blank"
				rel="noopener"
				class="bg-brand-gradient rounded-full px-4 py-2 text-sm font-semibold text-white transition-shadow hover:shadow-glow-purple"
			>
				Cotizar proyecto
			</a>

			<details class="relative md:hidden">
				<summary class="flex cursor-pointer list-none items-center rounded-full p-2 text-gray-soft hover:text-silver [&::-webkit-details-marker]:hidden" aria-label="Abrir menú">
					<Menu size={22} />
				</summary>
				<nav class="absolute right-0 mt-3 flex w-48 flex-col gap-1 rounded-2xl border border-white/10 bg-elevated p-2 shadow-xl" aria-label={`Menú de ${site.name}`}>
					{nav.map((item) => (
						<a href={item.href} class="rounded-xl px-3 py-2 text-sm text-gray-soft hover:bg-subtle hover:text-silver">{item.label}</a>
					))}
				</nav>
			</details>
		</div>
	</div>
</header>
