---
import SectionHeading from './SectionHeading.astro';
import { steps } from '../data/site';
---

<section id="proceso" class="scroll-mt-20 py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<SectionHeading
			eyebrow="Proceso"
			title="Así trabajamos contigo"
			description="Un proceso claro, con fechas y entregables definidos desde el inicio."
		/>

		<ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
			{steps.map((step, i) => (
				<li data-reveal class="relative rounded-3xl border border-white/5 bg-deep p-7">
					<span class="text-brand-gradient font-display text-5xl font-bold">0{i + 1}</span>
					<h3 class="mt-4 font-display text-xl font-semibold">{step.title}</h3>
					<p class="mt-3 text-gray-soft">{step.description}</p>
				</li>
			))}
		</ol>
	</div>
</section>
