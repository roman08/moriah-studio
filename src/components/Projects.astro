---
import { Image } from 'astro:assets';
import ExternalLink from 'lucide-astro/ExternalLink';
import MessageCircle from 'lucide-astro/MessageCircle';
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/site';

const groups = [
	{
		title: 'Para clientes',
		items: projects.filter((p) => p.type === 'Proyecto real'),
		grid: 'sm:grid-cols-2 lg:grid-cols-3',
		compact: false,
	},
	{
		title: 'Proyectos propios y demos',
		items: projects.filter((p) => p.type !== 'Proyecto real'),
		grid: 'sm:grid-cols-2 lg:grid-cols-4',
		compact: true,
	},
].filter((group) => group.items.length > 0);
---

<section id="proyectos" class="scroll-mt-20 py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<SectionHeading
			eyebrow="Proyectos"
			title="Trabajo que puedes ver"
			description="Proyectos para clientes, productos propios y demos que muestran lo que podemos construir para ti."
		/>

		<div class="space-y-14">
			{groups.map((group) => (
				<div>
					<h3 class="mb-6 text-sm font-semibold tracking-widest text-gray-soft uppercase" data-reveal>{group.title}</h3>
					<div class:list={['grid gap-6', group.grid]}>
						{group.items.map((project) => {
							const LinkIcon = project.linkLabel ? MessageCircle : ExternalLink;
							return (
								<a
									href={project.url}
									target="_blank"
									rel="noopener"
									data-reveal
									class="group flex flex-col overflow-hidden rounded-3xl border border-white/5 bg-deep transition-colors hover:border-brand-purple-500/40"
								>
									<div class="relative aspect-[4/3] overflow-hidden">
										<Image
											src={project.image}
											alt={`Captura de ${project.client}`}
											widths={[400, 800]}
											sizes={group.compact ? '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
											class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
										/>
										<span class="absolute top-4 left-4 rounded-full bg-void/80 px-3 py-1 text-xs font-semibold text-silver backdrop-blur">
											{project.type}
										</span>
									</div>
									<div class:list={['flex flex-1 flex-col', group.compact ? 'p-5' : 'p-6']}>
										<p class="text-sm text-brand-blue-400">{project.category}</p>
										<h4 class="mt-2 font-display text-lg font-semibold">{project.client}</h4>
										<p class:list={['mt-2 flex-1 text-gray-soft', group.compact && 'text-sm']}>{project.description}</p>
										{project.testimonial && (
											<figure class="mt-5 rounded-2xl border-l-2 border-brand-purple-500 bg-elevated p-4">
												<blockquote class="text-silver">“{project.testimonial.quote}”</blockquote>
												<figcaption class="mt-2 text-sm text-gray-soft">
													<span class="font-semibold text-silver">{project.testimonial.author}</span>, {project.testimonial.role}
												</figcaption>
											</figure>
										)}
										<span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-silver group-hover:text-brand-purple-400">
											{project.linkLabel ?? 'Ver sitio'} <LinkIcon size={16} />
										</span>
									</div>
								</a>
							);
						})}
					</div>
				</div>
			))}
		</div>
	</div>
</section>
